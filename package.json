{
  "name": "laurie-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Laurie's portfolio website",
  "type": "module",
  "scripts": {
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:js": "eslint js",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "build": "node scripts/build.mjs",
    "test": "npm run lint && npm run build && node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0"
  }
}
